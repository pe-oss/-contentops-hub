# ==============================================================================
# ContentOps Hub - Environment Configuration Template
# ==============================================================================

# Môi trường chạy: local | production
ENVIRONMENT=local

# DEBUG: True cho local, False bắt buộc cho production
DEBUG=True

# Feature Flags
# Mặc định False: tắt hiển thị bảng giá, CTA thanh toán và chặn route billing/webhook
BILLING_ENABLED=False

# SECRET_KEY:
# - Local: có thể để trống (sẽ tự fallback key dev tạm thời)
# - Production: BẮT BUỘC phải đặt khóa bí mật duy nhất, ngẫu nhiên và phức tạp.
#   Production sẽ từ chối khởi động nếu thiếu hoặc dùng key mặc định/insecure.
SECRET_KEY=

# ALLOWED_HOSTS: Danh sách hostnames cho phép, cách nhau bởi dấu phẩy
# Local mặc định: localhost,127.0.0.1
# Production ví dụ: app.yourdomain.com,.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# - Local: Để trống DATABASE_URL để tự động fallback SQLite (db.sqlite3).
# - Production: BẮT BUỘC dùng PostgreSQL qua DATABASE_URL. Production sẽ từ chối khởi động
#   nếu thiếu DATABASE_URL hoặc nếu dùng SQLite.
# Ví dụ PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# CSRF Trusted Origins: phân tách bằng dấu phẩy
# Bắt buộc khi chạy production qua HTTPS
# Ví dụ: https://app.yourdomain.com,https://your-service.onrender.com
CSRF_TRUSTED_ORIGINS=

# Cookie & Session Security (chỉ có hiệu lực khi DEBUG=False hoặc ENVIRONMENT=production)
# Mặc định là True trong production
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ==============================================================================
# Cấu hình Thanh toán & Webhook (Chỉ hoạt động khi BILLING_ENABLED=True)
# ==============================================================================
PAYOS_WEBHOOK_SECRET=
SEPAY_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Giá gói mẫu (chỉ dùng khi bật billing thử nghiệm)
PRO_PLAN_PRICE=199000
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Cấu hình Email (sẽ được chuẩn hóa ở B00.2)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
