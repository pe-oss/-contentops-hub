DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*,.onrender.com,localhost,127.0.0.1

# Database
# Dùng SQLite mặc định nếu DATABASE_URL trống.
# Ví dụ PostgreSQL (Supabase / Neon / Render):
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# CSRF trusted origins, phân tách bằng dấu phẩy
# Ví dụ: https://your-app.onrender.com,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Payments webhook secrets
PAYOS_WEBHOOK_SECRET=
SEPAY_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pricing / Checkout
PRO_PLAN_PRICE=199000
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Optional email settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True